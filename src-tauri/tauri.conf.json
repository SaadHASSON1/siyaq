{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Siyaq",
  "version": "0.6.4",
  "identifier": "app.siyaq.reader",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "سياق",
        "width": 1200,
        "height": 850,
        "minWidth": 400,
        "minHeight": 400,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Education",
    "shortDescription": "اعرف معنى أي كلمة حسب سياقها",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": [
          "pdf"
        ],
        "mimeType": "application/pdf",
        "name": "PDF Document",
        "role": "Viewer"
      },
      {
        "ext": [
          "epub"
        ],
        "mimeType": "application/epub+zip",
        "name": "EPUB Book",
        "role": "Viewer"
      }
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEFGQkIwNjA4RjlBM0Y1MDgKUldRSTlhUDVDQWE3cnl4RW1MWUFlR05pdHZKNG5YNUpNKytZeEkwcUdTaU54Qk4xTW1COFduNDQK",
      "endpoints": [
        "https://github.com/SaadHASSON1/siyaq/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
