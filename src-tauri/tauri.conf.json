{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Siyaq",
  "version": "0.2.0",
  "identifier": "app.siyaq.reader",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "سياق",
        "width": 1200,
        "height": 850,
        "minWidth": 400,
        "minHeight": 400,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Education",
    "shortDescription": "اعرف معنى أي كلمة حسب سياقها",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["pdf"],
        "mimeType": "application/pdf",
        "name": "PDF Document",
        "role": "Viewer"
      }
    ]
  }
}
